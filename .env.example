# Settings for compose.yaml. Copy to .env and fill in, or run scripts/init-env.sh (or .ps1),
# which generates every secret below. Never commit .env.

# Password for the local PostgreSQL container. Use letters and digits only.
POSTGRES_PASSWORD=change-me

# SHA-256 hex hashes of the four API keys, one per role. The server stores only hashes.
# Clients send the raw key as "Authorization: Bearer <key>".
LISTENER_KEY_HASH=
EVALUATOR_KEY_HASH=
APPROVER_KEY_HASH=
EXECUTOR_KEY_HASH=

# Optional repository provider tokens. When empty, reported pull requests are stored unverified.
# Grant read access to repositories, pull requests and checks only: never merge, admin or deploy rights.
GITHUB_TOKEN=
BITBUCKET_TOKEN=
# Set when the Bitbucket token is an API token used with basic authentication.
BITBUCKET_USERNAME=

# Host ports, all bound to 127.0.0.1.
API_PORT=5080
MCP_PORT=5081
POSTGRES_PORT=5432
